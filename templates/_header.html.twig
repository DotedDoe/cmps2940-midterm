{% set active = active|default('') %}
<header class="site-header">
  <div class="nav-inner">

    <nav class="main-nav">
      <a href="{{ path('home') }}"{% if active == 'home' %} class="active" aria-current="page"{% endif %}>Home</a>
      <a href="{{ path('inventory') }}"{% if active == 'inventory' %} class="active" aria-current="page"{% endif %}>Inventory</a>
      <a href="{{ path('create') }}"{% if active == 'create' %} class="active" aria-current="page"{% endif %}>Create Your Own</a>
      <a href="{{ path('about_us') }}"{% if active == 'about_us' %} class="active" aria-current="page"{% endif %}>About Us!</a>
    </nav>

    <div class="nav-icons">
      <a href="{{ path('cart') }}" class="nav-icon{% if active == 'cart' %} active{% endif %}" aria-label="Cart" title="Cart"{% if active == 'cart' %} aria-current="page"{% endif %}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 1.95-1.56L23 6H6"/>
        </svg>
        <span id="cart-count" class="cart-count">0</span>
      </a>

      {# Account / login icon: always links to the login page, which shows
         "You're signed in as ..." when someone is logged in #}
      <a href="{{ path('login') }}"
         class="nav-icon{% if active == 'login' %} active{% endif %}"
         aria-label="{{ app.user ? 'Account' : 'Login' }}"
         title="{{ app.user ? 'Signed in as ' ~ app.user.userIdentifier : 'Login' }}"
         {% if active == 'login' %}aria-current="page"{% endif %}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
        </svg>
      </a>

      {# Logout: only shown when signed in, beside the account icon #}
      {% if app.user %}
        <a href="{{ path('logout') }}" class="nav-icon" aria-label="Log out" title="Log out">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
        </a>
      {% endif %}
    </div>

  </div>
</header>