<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout — Cookie Time Cookie</title>

  <link rel="stylesheet" href="css/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

  <header class="site-header">
    <div class="nav-inner">
      <a href="index.html" class="logo">Cookie Time Cookie</a>
      <nav class="main-nav">
        <a href="index.html">Home</a>
        <a href="inventory.html">Inventory</a>
        <a href="cart.html">Cart <span id="cart-count" class="cart-count">0</span></a>
        <a href="login.html">Login</a>
        <a href="create.html">Create Your Own</a>
        <a href="about-us.html">About Us!</a>
      </nav>
    </div>
  </header>


  <div id="modeToggle">
    <button id="themeToggle">Dark Mode</button>
  </div>

  <main class="checkout-page">

    <h1>Checkout</h1>

    <p id="checkout-empty" class="empty-cart-message" hidden>
      Your cart is empty. Head over to the
      <a href="inventory.html">inventory</a> to find something sweet.
    </p>

    <div id="checkout-layout" class="checkout-layout">

      <form id="checkout-form" class="checkout-form">

        <fieldset>
          <legend>Contact</legend>
          <div class="form-grid">
            <div class="form-field">
              <label for="full-name">Full name</label>
              <input type="text" id="full-name" name="name" autocomplete="name" required>
            </div>
            <div class="form-field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" autocomplete="email" required>
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend>Shipping address</legend>
          <div class="form-grid">
            <div class="form-field full">
              <label for="address">Street address</label>
              <input type="text" id="address" name="address" autocomplete="street-address" required>
            </div>
            <div class="form-field">
              <label for="city">City</label>
              <input type="text" id="city" name="city" autocomplete="address-level2" required>
            </div>
            <div class="form-field">
              <label for="state">State</label>
              <input type="text" id="state" name="state" autocomplete="address-level1" maxlength="2" placeholder="LA" required>
            </div>
            <div class="form-field">
              <label for="zip">ZIP code</label>
              <input type="text" id="zip" name="zip" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{5}(-[0-9]{4})?" title="5-digit ZIP code" required>
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend>Payment</legend>
          <!-- PLACEHOLDER: add your payment provider here (Stripe, PayPal, etc.).
               Don't add raw card fields without one — nothing here processes or stores payments. -->
          <p class="payment-note">
            Online payment isn't set up yet. This is a demo checkout, so no payment will be taken when you place your order.
          </p>
        </fieldset>

        <button type="submit" class="checkout-btn">Place Order</button>
      </form>

      <aside class="order-summary">
        <h2>Order Summary</h2>
        <ul id="summary-lines" class="summary-lines"></ul>
        <div class="summary-row">
          <span>Total</span>
          <span id="summary-total">$0.00</span>
        </div>
      </aside>

    </div>

    <section id="order-confirmation" class="order-confirmation" hidden>
      <h2>Thank you!</h2>
      <p id="confirmation-message"></p>
      <p><a href="inventory.html">Keep shopping</a></p>
    </section>

  </main>

  <footer class="site-footer">
    <p>&copy; 2026 Cookie Time Cookie</p>
  </footer>

  <script src="js/app.js"></script>
  <script src="js/cart.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const items = getCartItems();
      const layout = document.getElementById('checkout-layout');
      const emptyMsg = document.getElementById('checkout-empty');

      // Nothing in the cart: show the empty message instead of the form
      if (items.length === 0) {
        layout.hidden = true;
        emptyMsg.hidden = false;
        return;
      }

      // Order summary
      const linesEl = document.getElementById('summary-lines');
      linesEl.innerHTML = items.map(item => {
        const options = item.selectedOptions.length
          ? `<small>${item.selectedOptions.map(o => o.name).join(', ')}</small>`
          : '';
        return `
          <li class="summary-line">
            <span>${item.qty} × ${item.name}${options}</span>
            <span>${formatPrice(item.unitPrice * item.qty)}</span>
          </li>
        `;
      }).join('');

      document.getElementById('summary-total').textContent =
        formatPrice(calculateCartTotal(items));

      // Place order
      document.getElementById('checkout-form').addEventListener('submit', (e) => {
        e.preventDefault();

        const name = document.getElementById('full-name').value.trim();
        const email = document.getElementById('email').value.trim();
        const total = calculateCartTotal(getCartItems());
        const orderNumber = 'CTC-' + Date.now().toString().slice(-6);

        // Empty the cart and update the badge
        saveCartItems([]);
        updateCartCountBadge();

        // TODO: send the order to your server / payment provider here

        document.getElementById('confirmation-message').textContent =
          `Thanks, ${name}! Order ${orderNumber} for ${formatPrice(total)} is placed. ` +
          `We'll send a confirmation to ${email}. (Demo only: no payment was taken.)`;

        layout.hidden = true;
        document.getElementById('order-confirmation').hidden = false;
        window.scrollTo(0, 0);
      });
    });
  </script>
</body>
</html>